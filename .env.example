APP_NAME=CityShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=888895
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
# Hostinger has no queue worker by default — use sync so mail + SMS send immediately.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Temporary: reuse WedPlan SMTP until CityShop has its own mailbox. Quote passwords that contain $.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.scholatrade.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="wedplanghana@scholatrade.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=scholatrade.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack (Ghana payments) — use live keys in production; never commit real secrets
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
# Passed to the customer on wallet recharge (MoMo / local card).
PAYSTACK_LOCAL_PERCENT=1.95
PAYSTACK_LOCAL_FLAT=0
VITE_PAYSTACK_PUBLIC_KEY="${PAYSTACK_PUBLIC_KEY}"

# When no admin funding setting exists, show CityShop MoMo top-up accounts
MANUAL_WALLET_TOPUP_DEFAULT_ENABLED=true

# Analytics (optional — leave blank to disable)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# SMS — Formula DC (default) and TxtConnect. Switch in Admin → Support → SMS platforms.
SMS_DRIVER=formula_dc
FORMULA_DC_API_KEY=
FORMULA_DC_SENDER=Cityshop
FORMULA_DC_BASE_URL=https://api.formula-dc.com/api/v1/external
# true = exercise API without delivering (staging). false = real SMS.
FORMULA_DC_TEST_MODE=false
TXTCONNECT_API_KEY=
TXTCONNECT_SENDER=CityShop
TXTCONNECT_BASE_URL=https://api.txtconnect.net/dev/api
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER=CityShop

# OpenAI — optional, improves image search with AI labels (gpt-4o-mini vision)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Firebase Cloud Messaging — optional OS push to the CityShop mobile app
# Firebase Console → Project settings → Cloud Messaging → Server key
FCM_SERVER_KEY=

# Android App Links fingerprint (SHA-256 of the signing cert). Comma-separate if you have debug + Play App Signing.
ANDROID_APP_SHA256=0E:35:E3:DB:D3:D7:09:40:8A:DD:0B:1B:0F:E3:04:92:FD:7F:81:AC:DD:D5:EC:0E:2E:BB:F7:3E:19:88:D8:95

# Seller Go Live — leave false until the feature is ready to ship again.
LIVESTREAM_ENABLED=false
# Jitsi host used when LIVESTREAM_ENABLED=true.
JITSI_DOMAIN=jitsi.riot.im

# WebRTC voice/video calls.
# STUN only discovers your public address. Ghanaian mobile networks put users
# behind carrier-grade NAT, so without a TURN relay two phones on mobile data
# will ring but never connect. Point TURN at coturn or a hosted provider
# (Twilio, Metered, Xirsys) and calls stop failing.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
